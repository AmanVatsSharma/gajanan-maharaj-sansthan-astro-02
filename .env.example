# ---------------------------------------------------------------------------
# SEO & Analytics environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (for local) or set values in your deployment platform.
# Keep production values aligned with your DNS/domain redirect settings.

# REQUIRED (production):
# Canonical site origin (Astro: use PUBLIC_* — see src/lib/seo/site-url.ts).
PUBLIC_SITE_URL=https://www.srigajananmaharajsanstan.com

# REQUIRED (production) — Google Analytics GA4:
# 1. Go to https://analytics.google.com → Admin → Create Property → Web
# 2. Copy the Measurement ID (format: G-XXXXXXXXXX)
# 3. Set it here and redeploy. Without this, zero booking funnel data is collected.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# OPTIONAL:
# Enable verbose SEO debug logs at runtime (prefer false in production).
PUBLIC_DEBUG_SEO=false

# OPTIONAL:
# Build standalone output when your infra expects it.
BUILD_STANDALONE=false

# IMPORTANT — Redirect loop fix:
# The live redirect verification was failing because of a www/non-www redirect loop.
# Choose ONE of these two approaches (never both):
#
# OPTION A — Let the app handle it (recommended for Vercel/Netlify):
#   1. Remove any www->non-www redirect from your hosting dashboard.
#   2. Set SEO_ENABLE_APP_HOST_REDIRECTS=true below.
#   This makes the app redirect srigajananmaharajsanstan.com -> www.srigajananmaharajsanstan.com
#
# OPTION B — Let the hosting platform handle it:
#   1. Configure your hosting/CDN to redirect apex -> www (same direction).
#   2. Keep SEO_ENABLE_APP_HOST_REDIRECTS=false (current default).
#   3. Verify no conflicting rule exists at platform level.
SEO_ENABLE_APP_HOST_REDIRECTS=false

# OPTIONAL (CI/manual post-deploy check):
# Enable live redirect verification script when running `npm run verify:live-redirects`.
# If false, script exits with a "skipped" status.
SEO_VERIFY_LIVE_REDIRECTS=false

# OPTIONAL:
# Override target origin for live redirect verification script.
# Useful for staging previews.
# SEO_LIVE_SITE_URL=https://www.srigajananmaharajsanstan.com

