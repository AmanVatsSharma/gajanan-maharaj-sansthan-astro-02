---
import type { BlogPost } from "@/lib/blog";
import BlogCard from "./BlogCard.astro";
import BlogPagination from "./BlogPagination.astro";

interface Props {
  title: string;
  description?: string;
  posts: BlogPost[];
  currentPage?: number;
  totalPages?: number;
  basePath?: string;
  breadcrumbLabel?: string;
}

const {
  title,
  description,
  posts,
  currentPage,
  totalPages,
  basePath = "/blog",
  breadcrumbLabel,
} = Astro.props;

const showPagination =
  typeof currentPage === "number" &&
  typeof totalPages === "number" &&
  totalPages > 1;
---

<section class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  {breadcrumbLabel && (
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-muted-foreground">
      <ol class="flex flex-wrap items-center gap-1">
        <li>
          <a href="/" class="hover:text-primary">Home</a>
        </li>
        <li aria-hidden="true">&rsaquo;</li>
        <li>
          <a href="/blog" class="hover:text-primary">Blog</a>
        </li>
        <li aria-hidden="true">&rsaquo;</li>
        <li class="font-medium text-foreground">{breadcrumbLabel}</li>
      </ol>
    </nav>
  )}

  <header class="mb-10">
    <h1 class="font-serif text-4xl font-bold text-foreground sm:text-5xl">
      {title}
    </h1>
    {description && (
      <p class="mt-3 max-w-3xl text-base text-muted-foreground sm:text-lg">
        {description}
      </p>
    )}
  </header>

  {posts && posts.length > 0 ? (
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  ) : (
    <p class="rounded-lg border border-dashed border-border bg-muted/40 p-8 text-center text-muted-foreground">
      No posts found.
    </p>
  )}

  {showPagination && (
    <BlogPagination
      currentPage={currentPage as number}
      totalPages={totalPages as number}
      basePath={basePath}
    />
  )}
</section>
