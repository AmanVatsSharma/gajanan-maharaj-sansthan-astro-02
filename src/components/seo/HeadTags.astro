---
import type { SitePageMetadata } from "@/lib/seo/metadata";
import { getHtmlTitle } from "@/lib/seo/metadata";
import { getSiteUrl } from "@/lib/seo/site-url";

interface Props {
  meta: SitePageMetadata;
  includeRssAlternate?: boolean;
}

const { meta, includeRssAlternate = true } = Astro.props;
const site = getSiteUrl();

function absUrl(pathOrUrl: string): string {
  if (pathOrUrl.startsWith("http://") || pathOrUrl.startsWith("https://")) {
    return pathOrUrl;
  }
  return new URL(pathOrUrl.replace(/^\//, ""), `${site}/`).toString();
}

const htmlTitle = getHtmlTitle(meta.title);
const ogImage = meta.openGraph?.images?.[0];
const ogImageUrl = ogImage ? absUrl(ogImage.url) : absUrl("/opengraph-image");
const canonical = meta.alternates?.canonical ?? site;

const keywordContent =
  meta.keywords && meta.keywords.length > 0
    ? meta.keywords.join(", ")
    : null;

const rssHref = new URL("/feed.xml", `${site}/`).toString();

const robotsContent =
  meta.robots != null
    ? [
        meta.robots.index ? "index" : "noindex",
        meta.robots.follow ? "follow" : "nofollow",
        ...(meta.robots.maxSnippet !== undefined
          ? [`max-snippet:${meta.robots.maxSnippet}`]
          : []),
      ].join(", ")
    : null;

const otherEntries = meta.other ? Object.entries(meta.other) : [];

// Detect whether page-level geo metadata was supplied via meta.other
// so we can skip the default Shegaon geo block and avoid double-emitting
// geo tags (which previously caused every page to ship Shegaon coords).
const pageGeoKeys = new Set(
  otherEntries
    .map(([name]) => name)
    .filter((name) => name.startsWith("geo.") || name === "ICBM")
);
const hasPageGeo = pageGeoKeys.size > 0;

// Hreflang alternates: prefer explicit list, otherwise default to en-IN + x-default.
// hi-IN and mr-IN are intentionally omitted: no Hindi/Marathi language variants exist,
// so emitting them with the same English canonical was a false duplicate-content signal.
const hreflangAlternates =
  meta.hreflangAlternates && meta.hreflangAlternates.length > 0
    ? meta.hreflangAlternates
    : [
        { hreflang: "en-IN", href: canonical },
        { hreflang: "x-default", href: canonical },
      ];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/icon.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-icon.png" />
<title>{htmlTitle}</title>
<meta name="description" content={meta.description} />
{keywordContent && <meta name="keywords" content={keywordContent} />}
<meta name="application-name" content="Shri Gajanan Maharaj Sansthan" />
<meta name="theme-color" content="#8B0000" />
<meta name="author" content="Shri Gajanan Maharaj Sansthan" />

<!-- Apple / mobile web-app meta (PWA polish) -->
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="SGMS Shegaon" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="format-detection" content="telephone=yes" />

{
  /* Default geo metadata (Shegaon HQ) — only emitted when the page did not
     provide its own geo.* keys via meta.other. Location pages supply their
     own coordinates, so this block stays silent for them. */
  !hasPageGeo && (
    <>
      <meta name="geo.region" content="IN-MH" />
      <meta name="geo.placename" content="Shegaon, Maharashtra, India" />
      <meta name="geo.position" content="20.7934;76.6983" />
      <meta name="ICBM" content="20.7934, 76.6983" />
    </>
  )
}
<link rel="canonical" href={canonical} />
{
  includeRssAlternate && (
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Shri Gajanan Maharaj Sansthan"
      href={rssHref}
    />
  )
}

<meta property="og:title" content={meta.openGraph?.title ?? htmlTitle} />
<meta property="og:description" content={meta.openGraph?.description ?? meta.description} />
<meta property="og:url" content={meta.openGraph?.url ?? canonical} />
<meta property="og:site_name" content={meta.openGraph?.siteName ?? ""} />
<meta property="og:locale" content={meta.openGraph?.locale ?? "en_IN"} />
<meta property="og:type" content={meta.openGraph?.type ?? "website"} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImage?.width ?? 1200)} />
<meta property="og:image:height" content={String(ogImage?.height ?? 630)} />
<meta property="og:image:alt" content={ogImage?.alt ?? htmlTitle} />
<meta property="og:image:type" content={ogImageUrl.endsWith(".png") ? "image/png" : "image/jpeg"} />

{meta.article?.publishedTime && (
  <meta property="article:published_time" content={meta.article.publishedTime} />
)}
{meta.article?.modifiedTime && (
  <meta property="article:modified_time" content={meta.article.modifiedTime} />
)}
{meta.article?.author && (
  <meta property="article:author" content={meta.article.author} />
)}
{meta.article?.section && (
  <meta property="article:section" content={meta.article.section} />
)}
{meta.article?.tags?.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<meta name="twitter:card" content={meta.twitter?.card ?? "summary_large_image"} />
<meta name="twitter:site" content="@sgms_shegaon" />
<meta name="twitter:title" content={meta.twitter?.title ?? htmlTitle} />
<meta name="twitter:description" content={meta.twitter?.description ?? meta.description} />
<meta
  name="twitter:image"
  content={absUrl(meta.twitter?.images?.[0] ?? "/opengraph-image")}
/>

{
  hreflangAlternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={absUrl(alt.href)} />
  ))
}

{meta.pagination?.prev && (
  <link rel="prev" href={absUrl(meta.pagination.prev)} />
)}
{meta.pagination?.next && (
  <link rel="next" href={absUrl(meta.pagination.next)} />
)}

{robotsContent && <meta name="robots" content={robotsContent} />}

{
  otherEntries.map(([name, value]) => (
    <meta name={name} content={String(value)} />
  ))
}
