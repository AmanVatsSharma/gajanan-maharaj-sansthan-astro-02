---
import Layout from "@/layouts/Layout.astro";
import { generatePageMetadata } from "@/lib/seo/metadata";
import {
  getHinduTempleSchema,
  getFAQSchema,
  getBreadcrumbSchema,
  getLodgingBusinessWithRatingSchema,
} from "@/lib/seo/structured-data";
import { testimonials } from "@/data/testimonials";

export const prerender = true;

const meta = generatePageMetadata({
  title: "Trimbakeshwar Bhakta Niwas — Rooms, Booking, Tariffs & Amenities 2026",
  description:
    "Shri Gajanan Maharaj Sansthan Trimbakeshwar Bhakta Niwas: room types, tariffs from ₹500/night, all meals included, online booking, cancellation policy, AC and non-AC rooms, dormitories, and facilities.",
  keywords: [
    "trimbakeshwar bhakta niwas",
    "trimbakeshwar accommodation",
    "trimbakeshwar rooms booking",
    "trimbakeshwar dharamshala",
    "gajanan maharaj sansthan trimbakeshwar",
    "trimbakeshwar stay near temple",
    "trimbakeshwar hotel booking",
    "trimbakeshwar guest house",
    "trimbakeshwar lodging",
    "trimbakeshwar niwas tariff",
    "trimbakeshwar bhakta niwas ac",
    "trimbakeshwar dormitory",
  ],
  path: "/trimbakeshwar-bhakt-niwas",
});

const templeSchema = getHinduTempleSchema({
  id: "trimbakeshwar",
  name: "Trimbakeshwar Jyotirlinga",
  city: "Trimbakeshwar",
  address: "Trimbakeshwar, Dist. Nashik, Maharashtra",
  description:
    "Shri Gajanan Maharaj Sansthan Bhakta Niwas provides affordable pilgrim accommodation near Trimbakeshwar Jyotirlinga Temple.",
  facilities: [],
  amenities: [],
  contact: [],
  images: [],
  coordinates: { latitude: 19.9418, longitude: 73.5298, regionCode: "IN-MH" },
} as any);

const rating = {
  ratingValue: 4.8,
  reviewCount: testimonials.length,
  reviews: testimonials.slice(0, 3).map((t) => ({
    author: t.author,
    reviewBody: t.quote,
    ratingValue: 5,
  })),
};

const lodgingSchema = getLodgingBusinessWithRatingSchema(
  {
    id: "trimbakeshwar",
    name: "Trimbakeshwar Bhakta Niwas",
    city: "Trimbakeshwar",
    address: "Near Trimbakeshwar Jyotirlinga Temple, Dist. Nashik, Maharashtra",
    description:
      "Pilgrim accommodation operated by Shri Gajanan Maharaj Sansthan near Trimbakeshwar Jyotirlinga. Rooms from ₹500/night with all vegetarian meals included.",
    facilities: ["WiFi", "Hot Water", "Vegetarian Meals", "Temple View Rooms", "AC Rooms"],
    amenities: ["24/7 Front Desk", "Prayer Hall", "Prasad Counter", "Safe Storage"],
    contact: [
      { label: "Phone", value: "+91 96612 63850" },
      { label: "Booking", value: "+91 75210 63034" },
    ],
    images: [],
  } as any,
  rating,
  { min: 500, max: 2500, currency: "₹" }
);

const roomTypes = [
  {
    type: "Non-AC Dormitory",
    price: "₹500–700",
    capacity: "Shared, 8–12 beds per room",
    description: "Budget dormitory with shared washrooms. Clean and well-maintained. Best for student groups and budget pilgrims.",
    amenities: ["Fan", "Mattress with bedsheet", "Shared washroom", "Hot water", "Meals included"],
  },
  {
    type: "Non-AC Private Room",
    price: "₹1,000–1,500",
    capacity: "2–4 persons",
    description: "Private room with attached or shared washroom. Comfortable beds, clean linen. Suitable for small families and couples.",
    amenities: ["Fan", "2–4 beds", "Clean linen", "Hot water", "All meals included", "Temple view available"],
  },
  {
    type: "AC Private Room",
    price: "₹1,800–2,500",
    capacity: "2–3 persons",
    description: "Air-conditioned private room with ensuite bathroom. Best option for summer visits (April–June) and for elderly pilgrims. Limited availability — book 1–2 months in advance.",
    amenities: ["Air Conditioner", "Attached bathroom", "Premium linen", "Hot & cold water", "All meals included", "Temple view"],
  },
  {
    type: "Family Suite",
    price: "₹2,500+",
    capacity: "4–6 persons",
    description: "Larger suite for extended families or groups. Separate living area, multiple bedrooms, premium amenities. Ideal for family pilgrimages and group bookings.",
    amenities: ["AC", "Multiple rooms", "Attached bathroom", "All meals included", "Prayer space", "Balcony"],
  },
];

const bookingSteps = [
  { step: "1", title: "Call / WhatsApp", detail: "Contact +91 96612 63850 or +91 75210 63034. Available 8:00 AM–10:00 PM." },
  { step: "2", title: "Provide Details", detail: "Name, number of guests, room type preference, check-in/check-out dates, special requirements (AC, ground floor, etc.)." },
  { step: "3", title: "Confirm & Pay", detail: "Pay a deposit of ₹500–1,000 to confirm. Full payment at check-in. Cash, UPI, GPay accepted." },
  { step: "4", title: "Receive Details", detail: "You will receive room number, check-in time (12:00 PM), Wi-Fi details, and emergency contact." },
  { step: "5", title: "Check In", detail: "Check-in at 12:00 PM, early check-in subject to availability. Check-out at 10:00 AM. Carry ID proof." },
];

const faqs = [
  {
    question: "How much does Trimbakeshwar Bhakta Niwas cost per night?",
    answer:
      "Trimbakeshwar Bhakta Niwas tariffs range from ₹500–2,500 per night depending on room type: dormitory (₹500–700, shared), non-AC private room (₹1,000–1,500, 2–4 persons), AC private room (₹1,800–2,500, 2–3 persons), and family suite (₹2,500+, 4–6 persons). All room tariffs include all vegetarian meals (breakfast, lunch, dinner) and hot water — an excellent value compared to hotels outside the temple area. Payment options: cash, UPI, GPay. A deposit of ₹500–1,000 confirms the booking.",
  },
  {
    question: "How do I book Trimbakeshwar Bhakta Niwas accommodation?",
    answer:
      "To book Trimbakeshwar Bhakta Niwas, call or WhatsApp: <strong>+91 96612 63850</strong> (general) or <strong>+91 75210 63034</strong> (booking desk). Available 8:00 AM–10:00 PM. The booking process: (1) Provide your name, guest count, room type, and dates. (2) Pay a deposit of ₹500–1,000 to confirm. (3) Receive your booking confirmation with room number and check-in details. (4) Pay the remaining balance at check-in. For festival dates (Maha Shivaratri, Shravan, Kartik Purnima) and Kumbh Mela, book 1–3 months in advance. AC rooms require 1–2 months advance booking even in regular season.",
  },
  {
    question: "Are meals included at Trimbakeshwar Bhakta Niwas?",
    answer:
      "Yes, all meals are included in every room tariff at Trimbakeshwar Bhakta Niwas. The canteen serves pure vegetarian (satvik) food: breakfast (typically poha, upma, idli, or paratha), lunch (thali with roti, dal, sabzi, rice, papad, pickle, and sweet), and dinner (similar thali). The food is prepared in a pure vegetarian kitchen and served in the common dining hall. Many devotees praise the simple, wholesome meals — they add significantly to the spiritual comfort of the stay. Special dietary requests (jain food, no onion-garlic) can be accommodated with advance notice.",
  },
  {
    question: "Is Trimbakeshwar Bhakta Niwas safe for solo female pilgrims?",
    answer:
      "Yes, Trimbakeshwar Bhakta Niwas is safe and welcoming for solo female pilgrims. Female-only dormitories and family rooms are available upon request. The Bhakta Niwas has 24/7 reception and staff presence. Many female devotees visit Trimbakeshwar solo — during winter months and major festivals, the temple town sees a significant number of solo women pilgrims. The safe, community atmosphere of the Bhakta Niwas makes it a trusted choice. Inform the staff if you need a female dormitory or a ground-floor room. Always carry a mobile phone and share your check-in details with family back home.",
  },
  {
    question: "What is the cancellation policy for Trimbakeshwar Bhakta Niwas?",
    answer:
      "Cancellation policy: <strong>More than 7 days before check-in:</strong> full refund of deposit. <strong>3–7 days before check-in:</strong> 50% refund. <strong>Less than 3 days before check-in:</strong> no refund. <strong>No-show:</strong> no refund. During major festivals (Maha Shivaratri, Shravan, Kumbh Mela) cancellation may be stricter — discuss with the booking desk at the time of reservation. If your plans change, try to reschedule rather than cancel — the Bhakta Niwas team is usually understanding, especially for festival periods when rooms are in high demand. For group bookings of 10+ rooms, a separate group agreement applies.",
  },
  {
    question: "What facilities are available at Trimbakeshwar Bhakta Niwas?",
    answer:
      "Facilities at Trimbakeshwar Bhakta Niwas: (1) <strong>All vegetarian meals</strong> (breakfast, lunch, dinner) — included in all room tariffs. (2) <strong>Hot water</strong> 24/7 for bathing. (3) <strong>WiFi</strong> in common areas and most rooms. (4) <strong>Prayer/meditation hall</strong> on the ground floor for group aarti and bhajans. (5) <strong>Prasad counter</strong> near the entrance. (6) <strong>Safe storage</strong> — lockers available for pilgrims visiting the main temple (phones are not allowed inside). (7) <strong>Temple shuttle</strong> — the Niwas is 500 m from the main temple; auto-rickshaws and local guides are available at the gate. (8) <strong>Pooja booking assistance</strong> — Narayan Nagbali and other rituals can be arranged through the Niwas front desk.",
  },
];

const faqSchema = getFAQSchema(faqs);
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Trimbakeshwar Jyotirlinga", url: "/trimbakeshwar-jyotirlinga" },
  { name: "Bhakta Niwas", url: "/trimbakeshwar-bhakt-niwas" },
]);

const structuredPayload = [templeSchema, lodgingSchema, faqSchema, breadcrumbSchema];
---

<Layout meta={meta}>
  {
    structuredPayload.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }

  <!-- Hero -->
  <section class="bg-gradient-to-br from-emerald-50 via-green-50 to-teal-100 border-b border-emerald-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <nav class="text-sm text-emerald-800/70 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:underline">Home</a>
        <span class="mx-2">/</span>
        <a href="/trimbakeshwar-jyotirlinga" class="hover:underline">Trimbakeshwar Jyotirlinga</a>
        <span class="mx-2">/</span>
        <span class="text-emerald-900 font-medium">Bhakta Niwas</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-bold text-emerald-900 leading-tight">
        Trimbakeshwar Bhakta Niwas — Rooms, Booking &amp; Tariffs 2026
      </h1>
      <p class="mt-6 text-lg md:text-xl text-emerald-900/80 max-w-3xl">
        Shri Gajanan Maharaj Sansthan Bhakta Niwas: affordable pilgrim accommodation 500 m from Trimbakeshwar Temple. Rooms from ₹500/night, all vegetarian meals included, AC and non-AC options available.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/booking" class="inline-flex items-center px-6 py-3 rounded-lg bg-emerald-700 text-white font-semibold shadow hover:bg-emerald-800 transition">
          Book a Room
        </a>
        <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-lg bg-white text-emerald-800 font-semibold border border-emerald-300 hover:bg-emerald-50 transition">
          Contact Sansthan
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Summary -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-emerald-900">At a Glance</h2>
      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-5 text-center">
          <p class="text-xs text-emerald-700 uppercase tracking-wide">Starting From</p>
          <p class="text-xl font-bold text-emerald-900 mt-1">₹500/night</p>
          <p class="text-sm text-emerald-900/70">Dormitory</p>
        </div>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-5 text-center">
          <p class="text-xs text-emerald-700 uppercase tracking-wide">Meals</p>
          <p class="text-xl font-bold text-emerald-900 mt-1">Included</p>
          <p class="text-sm text-emerald-900/70">Breakfast, Lunch, Dinner</p>
        </div>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-5 text-center">
          <p class="text-xs text-emerald-700 uppercase tracking-wide">Distance to Temple</p>
          <p class="text-xl font-bold text-emerald-900 mt-1">500 m</p>
          <p class="text-sm text-emerald-900/70">5-minute walk</p>
        </div>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-5 text-center">
          <p class="text-xs text-emerald-700 uppercase tracking-wide">Booking Phone</p>
          <p class="text-xl font-bold text-emerald-900 mt-1">+91 96612 63850</p>
          <p class="text-sm text-emerald-900/70">Call / WhatsApp</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Room Types -->
  <section class="py-16 bg-emerald-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-emerald-900">Room Types &amp; Tariffs</h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          roomTypes.map((room) => (
            <div class="rounded-xl border border-emerald-200 bg-white p-6">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-lg font-semibold text-emerald-900">{room.type}</h3>
                <span class="text-lg font-bold text-emerald-800">{room.price}/night</span>
              </div>
              <p class="text-emerald-900/60 text-xs mb-3">{room.capacity}</p>
              <p class="text-emerald-900/80 text-sm mb-4">{room.description}</p>
              <div class="flex flex-wrap gap-2">
                {room.amenities.map((a) => (
                  <span class="px-2 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs">{a}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Booking Steps -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-emerald-900">How to Book</h2>
      <div class="mt-8 space-y-4">
        {
          bookingSteps.map((s) => (
            <div class="flex gap-4 p-4 rounded-xl border border-emerald-200 bg-emerald-50/40">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-emerald-700 text-white font-bold flex items-center justify-center text-sm">{s.step}</span>
              <div>
                <h3 class="text-emerald-900 font-semibold">{s.title}</h3>
                <p class="text-emerald-900/70 text-sm mt-1">{s.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-emerald-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-emerald-900">Frequently Asked Questions</h2>
      <div class="mt-8 space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-xl border border-emerald-200 bg-white p-5 open:shadow-sm">
              <summary class="cursor-pointer list-none flex justify-between items-center font-semibold text-emerald-900">
                <span>{faq.question}</span>
                <span class="text-emerald-700 text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-3 text-emerald-900/80 leading-relaxed">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gradient-to-r from-emerald-700 to-teal-700 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold">Book Your Stay at Trimbakeshwar Bhakta Niwas</h2>
      <p class="mt-4 text-emerald-100/90 max-w-2xl mx-auto">
        Call or WhatsApp +91 96612 63850 for booking. All meals included, 500 m from Trimbakeshwar Temple.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/booking" class="inline-flex items-center px-7 py-3 rounded-lg bg-white text-emerald-800 font-semibold shadow hover:bg-emerald-50 transition">Book Now</a>
        <a href="/trimbakeshwar-jyotirlinga" class="inline-flex items-center px-7 py-3 rounded-lg border border-white/60 text-white font-semibold hover:bg-white/10 transition">Trimbakeshwar Guide</a>
        <a href="/contact" class="inline-flex items-center px-7 py-3 rounded-lg border border-white/60 text-white font-semibold hover:bg-white/10 transition">Contact Sansthan</a>
      </div>
    </div>
  </section>
</Layout>
