---
import Layout from "@/layouts/Layout.astro";
import { LocationCard } from "@/features/locations/components/LocationCard";
import { sansthanLocations } from "@/data/sansthan-data";
import { ScrollReveal } from "@/components/ui/scroll-reveal";
import { generatePageMetadata } from "@/lib/seo/metadata";
import {
  BRAND_VARIANTS,
  LOCATION_INTENT_KEYWORDS,
  LOCATION_KEYWORDS,
  ACCOMMODATION_HUB_KEYWORDS,
  NEAR_TEMPLE_KEYWORDS,
  SERVICES_KEYWORDS,
  getUniqueKeywords,
} from "@/lib/seo/constants";
import { getLocationsItemListSchema, getBreadcrumbSchema, getServiceSchema } from "@/lib/seo/structured-data";


const meta = generatePageMetadata({
  title: "Bhakta Niwas All Locations — Shri Gajanan Maharaj Sansthan | Shegaon, Pandharpur, Trimbakeshwar, Omkareshwar",
  description:
    "Book Bhakta Niwas at Shri Gajanan Maharaj Sansthan — Shegaon, Pandharpur, Trimbakeshwar, and Omkareshwar. Temple accommodation on donation basis for pilgrims.",
  keywords: getUniqueKeywords([
    ...BRAND_VARIANTS,
    ...Object.values(LOCATION_KEYWORDS).flat(),
    ...Object.values(LOCATION_INTENT_KEYWORDS).flat(),
    ...ACCOMMODATION_HUB_KEYWORDS,
    ...NEAR_TEMPLE_KEYWORDS,
    ...SERVICES_KEYWORDS,
    "temple locations",
    "bhakt niwas network",
    "sansthan branches",
    "bhakta niwas all locations booking",
    "gajanan maharaj sansthan all bhakta niwas",
  ]),
  path: "/locations",
});

const itemListSchema = getLocationsItemListSchema(
  sansthanLocations.map((l) => ({
    id: l.id,
    name: l.name,
    city: l.city,
    description: l.description,
  }))
);
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Locations", url: "/locations" },
]);
const serviceSchema = getServiceSchema();
---

<Layout meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="container py-12">
    <ScrollReveal client:visible>
      <div class="mb-12 text-center">
        <h1 class="text-4xl font-bold font-heading text-brand-maroon mb-4">Sansthan Locations</h1>
        <p class="text-muted-foreground max-w-2xl mx-auto text-lg">
          Accommodations managed by Shri Gajanan Maharaj Sansthan across various holy places.
        </p>
      </div>
    </ScrollReveal>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        sansthanLocations.map((location, index) => (
          <ScrollReveal client:visible delay={index * 0.1} className="h-full">
            <LocationCard location={location} />
          </ScrollReveal>
        ))
      }
    </div>

    
    <ScrollReveal client:visible className="mt-16">
      <h2 class="text-2xl font-bold font-heading text-brand-maroon mb-4 text-center">
        Planning your visit
      </h2>
      <p class="text-muted-foreground text-center mb-8 max-w-2xl mx-auto">
        Use the booking page for requests, or contact us for maps and office hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/booking"
          class="inline-flex items-center gap-2 font-medium text-brand-saffron hover:text-brand-maroon transition-colors"
        >
          Booking request
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 font-medium text-brand-saffron hover:text-brand-maroon transition-colors"
        >
          Contact
        </a>
      </div>
    </ScrollReveal>
  </div>
</Layout>
