---
import Layout from "@/layouts/Layout.astro";
import { ROOMS, PRICING_TRANSPARENCY } from "@/data/rooms";
import { sansthanLocations } from "@/data/sansthan-data";
import { generatePageMetadata } from "@/lib/seo/metadata";
import {
  getLodgingBusinessWithRatingSchema,
  getFAQSchema,
  getBreadcrumbSchema,
} from "@/lib/seo/structured-data";
import { testimonials } from "@/data/testimonials";

export const prerender = true;

const shegaon = sansthanLocations.find(
  (l) => l.id === "shegaon-bhakt-niwas"
);
if (!shegaon) {
  return Astro.redirect("/404");
}

// Shegaon-relevant rooms (use full room catalog — Shegaon is the flagship location).
const shegaonRooms = ROOMS;

const meta = generatePageMetadata({
  title:
    "Shegaon Accommodation — Book Bhakta Niwas at Shri Gajanan Maharaj Sansthan",
  description:
    "Book affordable Shegaon accommodation at Bhakta Niwas near Shri Gajanan Maharaj Temple. Family rooms ₹1,250–₹4,150 with all meals, hot water, and free bus service. Reserve your stay online.",
  keywords: [
    "shegaon accommodation",
    "bhakta niwas shegaon",
    "shegaon room booking",
    "shegaon dharamshala",
    "gajanan maharaj sansthan shegaon stay",
    "shegaon family room",
    "shegaon bhakt niwas booking",
    "shegaon temple accommodation",
  ],
  path: "/shegaon-accommodation",
});

const rating = {
  ratingValue: 4.9,
  reviewCount: testimonials.length,
  reviews: testimonials.slice(0, 3).map((t) => ({
    author: t.author,
    reviewBody: t.quote,
    ratingValue: 5,
  })),
};

const lodgingSchema = getLodgingBusinessWithRatingSchema(
  shegaon,
  rating,
  { min: 1250, max: 4150, currency: "₹" }
);

const faqs = [
  {
    question: "What is the cheapest Bhakta Niwas room in Shegaon?",
    answer:
      "The 2 Bed Non-AC room is the most affordable option at Bhakta Niwas Shegaon, with a suggested donation of ₹1,250 per night. The price includes the room, all three meals (breakfast, lunch, dinner), and hot water.",
  },
  {
    question: "How do I book a room at Shri Gajanan Maharaj Sansthan?",
    answer:
      "You can book online through the Sansthan's official booking page at /booking, call the Bhakta Niwas helpline, or visit the Sansthan office at Shegaon. Online booking is the fastest way to confirm a room and is recommended during festivals.",
  },
  {
    question: "Is parking available at Bhakta Niwas Shegaon?",
    answer:
      "Yes. Free parking is available at the Shegaon Bhakta Niwas complex for cars, two-wheelers, and tempo travellers. Parking is unattended but the area is inside the secured Sansthan campus.",
  },
  {
    question: "What are the darshan timings at Shegaon temple?",
    answer:
      "The Shri Gajanan Maharaj Samadhi Mandir at Shegaon is open for darshan from approximately 5:00 AM to 9:30 PM every day. Kakad Aarti is at sunrise, Madhyan Aarti at noon, and Shejjarati at night — check the temple notice board for the daily schedule.",
  },
  {
    question: "Are families allowed to stay in Bhakta Niwas?",
    answer:
      "Yes. Bhakta Niwas is reserved primarily for family pilgrims. A government-issued photo ID is required for all guests and a minimum of three family members is generally required to book a private room. Unmarried couples are not permitted.",
  },
  {
    question: "How far is Shegaon bus stand from Bhakta Niwas?",
    answer:
      "The Shegaon bus stand (MSRTC) is about 2 kilometres from the Bhakta Niwas complex. The Sansthan runs a free shuttle bus between Bhakta Niwas and the temple during peak hours, and autos and e-rickshaws are available outside the bus stand.",
  },
  {
    question: "Can I cancel my booking?",
    answer:
      "Yes. You can cancel a Bhakta Niwas Shegaon booking by calling the Sansthan helpline or emailing the booking office. Cancelling at least 24 hours before check-in allows your room to be reassigned to another waiting devotee without any charges.",
  },
];

const faqSchema = getFAQSchema(faqs);
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Shegaon Accommodation", url: "/shegaon-accommodation" },
]);

const structuredPayload = [lodgingSchema, faqSchema, breadcrumbSchema];

const whySansthan = [
  {
    title: "Inside the temple campus",
    body: "Bhakta Niwas sits a short walk from the Shri Gajanan Maharaj Samadhi Mandir, so you can join aarti without arranging transport.",
  },
  {
    title: "All meals included",
    body: "Every room rate covers breakfast, lunch and dinner at the Mahaprasad canteen — sattvic, freshly prepared and served at fixed meal times.",
  },
  {
    title: "Transparent pricing",
    body: "No hidden charges, no agent commissions. The price you see is the price you pay, with suggested donations ranging from ₹1,250 to ₹4,150 per night.",
  },
  {
    title: "Free bus service & parking",
    body: "Free shuttle buses run between Bhakta Niwas and the temple campus, and ample parking is available for cars and two-wheelers.",
  },
  {
    title: "Disciplined, family-first stay",
    body: "Bhakta Niwas is reserved for family pilgrims. ID verification and a 24-hour check-in / check-out policy keep the complex calm and orderly.",
  },
];

const bookingSteps = [
  "Visit the Sansthan booking page and choose your check-in and check-out dates.",
  "Select a room type from the Shegaon Bhakta Niwas list (2 Bed, 3 Bed, 4 Bed, Family, Deluxe or Luxury Suite).",
  "Fill in primary guest details — name, mobile number, Aadhar / Voter ID, and number of family members.",
  "Pay the suggested donation online (UPI, card, netbanking) or opt to pay at the Sansthan office on arrival.",
  "Receive an SMS and email confirmation with your booking ID, room allotment and check-in instructions.",
];
---

<Layout meta={meta}>
  {
    structuredPayload.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }

  <!-- Hero -->
  <section class="bg-gradient-to-br from-orange-50 via-amber-50 to-orange-100 border-b border-orange-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <nav class="text-sm text-orange-800/70 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:underline">Home</a>
        <span class="mx-2">/</span>
        <span class="text-orange-900 font-medium">Shegaon Accommodation</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-bold text-orange-900 leading-tight">
        Shegaon Accommodation — Book Bhakta Niwas at Shri Gajanan Maharaj Sansthan
      </h1>
      <p class="mt-6 text-lg md:text-xl text-orange-900/80 max-w-3xl">
        Affordable, family-friendly stay inside the Sansthan campus at Shegaon.
        Book Bhakta Niwas rooms a short walk from the Samadhi Mandir with all
        meals, hot water and free shuttle bus included.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/booking"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-orange-700 text-white font-semibold shadow hover:bg-orange-800 transition"
        >
          Book a Room
        </a>
        <a
          href="/contact"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-white text-orange-800 font-semibold border border-orange-300 hover:bg-orange-50 transition"
        >
          Contact Sansthan
        </a>
      </div>
    </div>
  </section>

  <!-- Why book with Sansthan -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-orange-900">
        Why book your Shegaon stay with the Sansthan
      </h2>
      <p class="mt-3 text-orange-900/80 max-w-3xl">
        Bhakta Niwas is run directly by Shri Gajanan Maharaj Sansthan — the same
        trust that manages the temple. Booking with the Sansthan means fair
        pricing, sattvic meals, and the cleanest rooms in Shegaon.
      </p>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          whySansthan.map((item) => (
            <div class="rounded-xl border border-orange-200 bg-orange-50/40 p-6">
              <h3 class="text-lg font-semibold text-orange-900">{item.title}</h3>
              <p class="mt-2 text-orange-900/80 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Room types table -->
  <section class="py-16 bg-orange-50/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-orange-900">
        Shegaon Bhakta Niwas room types &amp; pricing
      </h2>
      <p class="mt-3 text-orange-900/80 max-w-3xl">
        All room rates at Bhakta Niwas Shegaon include accommodation, three
        meals per day, hot water and applicable taxes. There are no hidden
        charges — the price you see is the price you pay.
      </p>

      <div class="mt-8 overflow-x-auto rounded-xl border border-orange-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm md:text-base">
          <thead class="bg-orange-100 text-orange-900">
            <tr>
              <th class="px-4 py-3 font-semibold">Room Type</th>
              <th class="px-4 py-3 font-semibold">Capacity</th>
              <th class="px-4 py-3 font-semibold">AC</th>
              <th class="px-4 py-3 font-semibold text-right">Suggested Donation</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-orange-100 text-orange-900">
            {
              shegaonRooms.map((room) => (
                <tr class="hover:bg-orange-50/60">
                  <td class="px-4 py-3 font-medium">{room.title}</td>
                  <td class="px-4 py-3">{room.capacity} persons</td>
                  <td class="px-4 py-3">{room.ac ? "Yes" : "No"}</td>
                  <td class="px-4 py-3 text-right font-semibold">
                    ₹{room.price.toLocaleString("en-IN")}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-xs md:text-sm text-orange-900/70">
        {PRICING_TRANSPARENCY.disclaimer}. {PRICING_TRANSPARENCY.noHiddenCharges}.
        {PRICING_TRANSPARENCY.checkInOut}.
      </p>

      <div class="mt-8">
        <a
          href="/booking"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-orange-700 text-white font-semibold shadow hover:bg-orange-800 transition"
        >
          Reserve a room now
        </a>
      </div>
    </div>
  </section>

  <!-- 5-step booking guide -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-orange-900">
        How to book a Shegaon Bhakta Niwas room — 5-step guide
      </h2>
      <p class="mt-3 text-orange-900/80 max-w-3xl">
        Follow these simple steps to confirm your Shegaon accommodation. Online
        booking is the fastest way to lock in a room, especially around
        festivals like Maghi Purnima and Chaitra Padma.
      </p>
      <ol class="mt-10 space-y-4">
        {
          bookingSteps.map((step, idx) => (
            <li class="flex gap-4 items-start rounded-xl border border-orange-200 bg-orange-50/40 p-5">
              <span class="flex-shrink-0 w-9 h-9 rounded-full bg-orange-700 text-white font-bold flex items-center justify-center">
                {idx + 1}
              </span>
              <p class="text-orange-900 leading-relaxed">{step}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-orange-50/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-orange-900">
        Frequently asked questions — Shegaon accommodation
      </h2>
      <div class="mt-8 space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-xl border border-orange-200 bg-white p-5 open:shadow-sm">
              <summary class="cursor-pointer list-none flex justify-between items-center font-semibold text-orange-900">
                <span>{faq.question}</span>
                <span class="text-orange-700 text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-3 text-orange-900/80 leading-relaxed">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Related blog posts -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-orange-900">
        Shegaon travel &amp; accommodation guides
      </h2>
      <p class="mt-3 text-orange-900/80 max-w-3xl">
        Plan your Shegaon yatra with our handpicked guides on accommodation,
        darshan, travel routes and nearby places to visit.
      </p>
      <ul class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          [
            { slug: "shegaon-accommodation-guide", title: "Shegaon Accommodation Guide" },
            { slug: "shegaon-travel-guide", title: "How to Reach Shegaon — Travel Guide" },
            { slug: "nearby-places-from-shegaon", title: "Places to Visit Near Shegaon" },
            { slug: "bhakta-niwas-booking-guide", title: "Bhakta Niwas Booking — Step by Step" },
            { slug: "shegaon-darshan-timing-guide", title: "Shegaon Darshan Timings & Aarti Schedule" },
          ].map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}`}
                class="block rounded-xl border border-orange-200 bg-orange-50/40 p-5 hover:bg-orange-100 transition"
              >
                <span class="text-orange-900 font-semibold">{post.title}</span>
                <span class="block mt-1 text-sm text-orange-800/70">Read guide →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-gradient-to-r from-orange-700 to-amber-700 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold">
        Ready to book your Shegaon Bhakta Niwas room?
      </h2>
      <p class="mt-4 text-orange-50/90 max-w-2xl mx-auto">
        Confirm your stay in minutes. Suggested donations start at ₹1,250 with
        all meals and hot water included. Family rooms available.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/booking"
          class="inline-flex items-center px-7 py-3 rounded-lg bg-white text-orange-800 font-semibold shadow hover:bg-orange-50 transition"
        >
          Book on /booking
        </a>
        <a
          href="/locations/shegaon-bhakt-niwas"
          class="inline-flex items-center px-7 py-3 rounded-lg border border-white/60 text-white font-semibold hover:bg-white/10 transition"
        >
          See Shegaon Bhakt Niwas page
        </a>
        <a
          href="/contact"
          class="inline-flex items-center px-7 py-3 rounded-lg border border-white/60 text-white font-semibold hover:bg-white/10 transition"
        >
          Contact Sansthan
        </a>
      </div>
    </div>
  </section>
</Layout>
