---
import Layout from "@/layouts/Layout.astro";
import { BlogPostBody } from "@/features/blog/components/BlogPostBody";
import {
  getBlogPost,
  getBlogPosts,
  getRelatedPosts,
} from "@/lib/blog";
import { generatePageMetadata } from "@/lib/seo/metadata";
import { getArticleSchema, getBreadcrumbSchema, getOrganizationSchema } from "@/lib/seo/structured-data";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const slug = Astro.params.slug!;
const post = await getBlogPost(slug);

if (!post) {
  throw new Error(`Missing blog post for slug: ${slug}`);
}

const relatedPosts = await getRelatedPosts(post, 5);

const meta = generatePageMetadata({
  title: post.title,
  description: post.description,
  keywords: post.keywords || post.tags,
  image: post.image,
  path: `/blog/${post.slug}`,
  type: "article",
  noIndex: post.noIndex,
  article: {
    publishedTime: post.date,
    modifiedTime: post.lastModified,
    author: post.author,
    section: post.category,
    tags: post.tags,
  },
});

const articleSchema = getArticleSchema({
  title: post.title,
  date: post.date,
  slug: `/blog/${post.slug}`,
  description: post.description,
  author: post.author,
  image: post.image,
  dateModified: post.lastModified,
  keywords: post.keywords,
  tags: post.tags,
  category: post.category,
  rawContent: post.rawContent,
  relatedPosts: relatedPosts.map((p) => ({ title: p.title, slug: p.slug })),
});

// Extract FAQs for schema if they exist in the HTML
const faqRegex = /<strong[^>]*>(.*?)<\/strong>\s*(.*?)(?=<strong|$)/gs;
const faqs: Array<{ question: string; answer: string }> = [];
let faqMatch;
const faqSection = post.content.split('Frequently asked questions')[1];

if (faqSection) {
  while ((faqMatch = faqRegex.exec(faqSection)) !== null) {
    const question = faqMatch[1].replace(/<[^>]*>?/gm, '').trim();
    const answer = faqMatch[2].replace(/<[^>]*>?/gm, '').trim();
    if (question && answer) {
      faqs.push({ question, answer });
    }
  }
}

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog" },
  { name: post.title, url: `/blog/${post.slug}` },
]);

const organizationSchema = getOrganizationSchema();
---

<Layout meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <div class="container py-12">
    <BlogPostBody post={post} relatedPosts={relatedPosts} />
  </div>
</Layout>
