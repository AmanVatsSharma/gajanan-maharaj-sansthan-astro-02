---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import BlogPostBody from "@/components/blog/BlogPostBody.astro";
import RelatedPosts from "@/components/blog/RelatedPosts.astro";
import { generatePageMetadata } from "@/lib/seo/metadata";
import {
  getArticleSchema,
  getBreadcrumbSchema,
  getFAQSchema,
} from "@/lib/seo/structured-data";
import {
  getBlogPosts,
  getBlogPost,
  getRelatedPosts,
} from "@/lib/blog";

export async function getStaticPaths() {
  const posts = getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug as string);

if (!post) {
  return Astro.redirect("/404");
}

const related = getRelatedPosts(post, 6);

const formattedDate = (() => {
  try {
    const d = new Date(post.date);
    if (Number.isNaN(d.getTime())) return post.date;
    return d.toLocaleDateString("en-IN", {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  } catch {
    return post.date;
  }
})();

const meta = generatePageMetadata({
  title: post.title,
  description: post.description,
  keywords: post.keywords,
  image: post.image,
  path: `/blog/${post.slug}`,
  type: "article",
  article: {
    publishedTime: post.date,
    modifiedTime: post.dateModified,
    author: post.author,
    section: post.category,
    tags: post.tags,
  },
});

const articleJsonLd = JSON.stringify(getArticleSchema(post));
const breadcrumbJsonLd = JSON.stringify(
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog" },
    { name: post.title, url: `/blog/${post.slug}` },
  ]),
);
const faqJsonLd =
  post.faqs && post.faqs.length > 0
    ? JSON.stringify(getFAQSchema(post.faqs))
    : null;
---

<Layout meta={meta}>
  <script type="application/ld+json" set:html={articleJsonLd} />
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}

  <article class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-primary">Home</a></li>
        <li aria-hidden="true">&rsaquo;</li>
        <li><a href="/blog" class="hover:text-primary">Blog</a></li>
        <li aria-hidden="true">&rsaquo;</li>
        <li class="font-medium text-foreground line-clamp-1">{post.title}</li>
      </ol>
    </nav>

    <header class="mb-8">
      {post.category && (
        <a
          href={`/blog/category/${post.category.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`}
          class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary hover:bg-primary/20"
        >
          {post.category}
        </a>
      )}

      <h1 class="mt-4 font-serif text-3xl font-bold leading-tight text-foreground sm:text-4xl md:text-5xl">
        {post.title}
      </h1>

      {post.description && (
        <p class="mt-4 text-lg text-muted-foreground">
          {post.description}
        </p>
      )}

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
        <time datetime={post.date} class="font-medium">{formattedDate}</time>
        <span aria-hidden="true">&bull;</span>
        <span>{post.readingTimeMinutes} min read</span>
        {post.author && (
          <>
            <span aria-hidden="true">&bull;</span>
            <span>By {post.author}</span>
          </>
        )}
      </div>

      {post.tags && post.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.tags.map((tag) => {
            const tagSlug = tag.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
            return (
              <a
                href={`/blog/tag/${tagSlug}`}
                class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-foreground hover:border-primary hover:text-primary"
              >
                #{tag}
              </a>
            );
          })}
        </div>
      )}
    </header>

    {post.image && (
      <figure class="mb-10 overflow-hidden rounded-xl border border-border bg-muted">
        <img
          src={post.image}
          alt={post.title}
          loading="eager"
          decoding="async"
          class="aspect-[16/9] w-full object-cover"
        />
      </figure>
    )}

    <BlogPostBody htmlContent={post.htmlContent} wordCount={post.wordCount} />

    {post.faqs && post.faqs.length > 0 && (
      <section class="mt-12 border-t border-border pt-10" aria-labelledby="faqs-heading">
        <h2 id="faqs-heading" class="mb-6 font-serif text-2xl font-bold text-foreground sm:text-3xl">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {post.faqs.map((faq) => (
            <details class="group rounded-lg border border-border bg-card p-4">
              <summary class="cursor-pointer text-base font-semibold text-foreground">
                {faq.question}
              </summary>
              <p class="mt-3 text-sm text-muted-foreground">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <RelatedPosts posts={related} />
  </article>
</Layout>
