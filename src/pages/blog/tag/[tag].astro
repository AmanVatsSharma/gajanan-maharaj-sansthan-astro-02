---
import Layout from "@/layouts/Layout.astro";
import { BlogTaxonomyPageBody } from "@/features/blog/components/BlogTaxonomyPageBody";
import { BLOG_FEATURED_PILLAR_SLUGS } from "@/features/blog/constants";
import {
  formatTaxonomyLabel,
  getAllTags,
  getPostsByTag,
  getPostsBySlugs,
} from "@/lib/blog";
import { BRAND_VARIANTS, getUniqueKeywords } from "@/lib/seo/constants";
import { generatePageMetadata } from "@/lib/seo/metadata";
import {
  getBreadcrumbSchema,
  getCollectionPageSchema,
} from "@/lib/seo/structured-data";

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag!;
const posts = await getPostsByTag(tag);
const tagLabel = formatTaxonomyLabel(tag);

if (posts.length === 0) {
  throw new Error(`No posts for tag: ${tag}`);
}

const featuredPosts = await getPostsBySlugs([...BLOG_FEATURED_PILLAR_SLUGS]);

const description = `Read ${tagLabel.toLowerCase()} articles, travel guides, booking tips, and devotional updates from Shri Gajanan Maharaj Sansthan, Shegaon. Plan your pilgrimage with the latest ${tagLabel.toLowerCase()} content.`;

const meta = generatePageMetadata({
  title: `${tagLabel} Articles`,
  description,
  path: `/blog/tag/${tag}`,
  noIndex: posts.length === 0,
  keywords: getUniqueKeywords([
    ...BRAND_VARIANTS,
    `gajanan maharaj ${tagLabel.toLowerCase()}`,
    `${tagLabel.toLowerCase()} shegaon`,
    `${tagLabel.toLowerCase()} bhakta niwas`,
    "sansthan blog",
    "gajanan maharaj sansthan articles",
  ]),
});

const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog" },
  { name: tagLabel, url: `/blog/tag/${tag}` },
]);

const collectionSchema = getCollectionPageSchema({
  path: `/blog/tag/${tag}`,
  title: `${tagLabel} Articles - Shri Gajanan Maharaj Sansthan`,
  description,
  items: posts.map((post) => ({
    title: post.title,
    urlPath: `/blog/${post.slug}`,
    description: post.description,
    date: post.date,
    image: post.image,
    keywords: post.keywords,
    category: post.category,
  })),
});

const structuredPayload = [breadcrumbSchema, collectionSchema];
---

<Layout meta={meta}>
  {
    structuredPayload.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }
  <BlogTaxonomyPageBody
    kind="tag"
    taxonomySlug={tag}
    label={tagLabel}
    posts={posts}
    featuredPosts={featuredPosts}
  />
</Layout>
