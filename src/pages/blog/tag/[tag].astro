---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import BlogListingLayout from "@/components/blog/BlogListingLayout.astro";
import { generatePageMetadata } from "@/lib/seo/metadata";
import { getCollectionPageSchema } from "@/lib/seo/structured-data";
import { getTags, getPostsByTag } from "@/lib/blog";
import type { CollectionPageItem } from "@/lib/seo/structured-data";

export async function getStaticPaths() {
  const tags = getTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { label: tag.label },
  }));
}

interface TagProps {
  label: string;
}

const { label } = Astro.props as TagProps;
const slug = Astro.params.tag as string;
const posts = getPostsByTag(slug);

const description = `Posts tagged "${label}" — articles, guides and stories from Shri Gajanan Maharaj Sansthan Shegaon.`;

const collectionItems: CollectionPageItem[] = posts.map((post) => ({
  title: post.title,
  urlPath: `/blog/${post.slug}`,
  description: post.description,
  date: post.date,
  image: post.image,
  keywords: post.keywords,
  category: post.category,
}));

const meta = generatePageMetadata({
  title: `#${label} — Blog`,
  description,
  keywords: [label, "Shri Gajanan Maharaj Blog", "Shegaon temple blog"],
  path: `/blog/tag/${slug}`,
});

const collectionJsonLd = JSON.stringify(
  getCollectionPageSchema({
    path: `/blog/tag/${slug}`,
    title: `#${label} — Shri Gajanan Maharaj Sansthan Blog`,
    description,
    items: collectionItems,
  }),
);
---

<Layout meta={meta}>
  <script type="application/ld+json" set:html={collectionJsonLd} />
  <BlogListingLayout
    title={`#${label} — Blog`}
    description={description}
    posts={posts}
    basePath="/blog"
    breadcrumbLabel={`#${label}`}
  />
</Layout>
