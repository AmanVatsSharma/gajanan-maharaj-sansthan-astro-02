---
import Layout from "@/layouts/Layout.astro";
import { generatePageMetadata } from "@/lib/seo/metadata";
import {
  getHinduTempleSchema,
  getFAQSchema,
  getBreadcrumbSchema,
  getLodgingBusinessWithRatingSchema,
} from "@/lib/seo/structured-data";
import { testimonials } from "@/data/testimonials";

export const prerender = true;

const meta = generatePageMetadata({
  title: "Narayan Nagbali Pooja at Trimbakeshwar — Ritual, Cost & Booking Guide 2026",
  description:
    "Complete guide to Narayan Nagbali pooja at Trimbakeshwar Jyotirlinga: the only ritual to remove Pitru Dosha (ancestral curse), pooja procedure, cost, booking process, who should perform it, timings, and what to expect.",
  keywords: [
    "narayan nagbali trimbakeshwar",
    "narayan nagbali pooja",
    "pitru dosha removal trimbakeshwar",
    "nagbali pooja trimbakeshwar",
    "nag bali pooja trimbakeshwar",
    "pitru dosh nivaran trimbakeshwar",
    "pitru dosha remedy",
    "ancestral curse removal india",
    "nagbali pooja cost",
    "nagbali booking trimbakeshwar",
    "trimbakeshwar special pooja",
    "nag pooja trimbakeshwar",
    "narayan nagbali procedure",
    "narayan nagbali booking trimbakeshwar",
  ],
  path: "/narayan-nagbali-trimbakeshwar",
});

const templeSchema = getHinduTempleSchema({
  id: "trimbakeshwar",
  name: "Trimbakeshwar Jyotirlinga",
  city: "Trimbakeshwar",
  address: "Trimbakeshwar, Dist. Nashik, Maharashtra",
  description:
    "One of the 12 Jyotirlingas of Lord Shiva, the only temple in India where Narayan Nagbali pooja is performed to remove Pitru Dosha and grant peace to departed souls.",
  facilities: [],
  amenities: [],
  contact: [],
  images: [],
  coordinates: { latitude: 19.9418, longitude: 73.5298, regionCode: "IN-MH" },
} as any);

const rating = {
  ratingValue: 4.8,
  reviewCount: testimonials.length,
  reviews: testimonials.slice(0, 3).map((t) => ({
    author: t.author,
    reviewBody: t.quote,
    ratingValue: 5,
  })),
};

const lodgingSchema = getLodgingBusinessWithRatingSchema(
  {
    id: "trimbakeshwar",
    name: "Trimbakeshwar Bhakta Niwas",
    city: "Trimbakeshwar",
    address: "Near Trimbakeshwar Jyotirlinga Temple",
    description: "Pilgrim accommodation near Trimbakeshwar temple.",
    facilities: [],
    amenities: [],
    contact: [],
    images: [],
  } as any,
  rating,
  { min: 500, max: 2500, currency: "₹" }
);

const faqs = [
  {
    question: "What is Narayan Nagbali pooja at Trimbakeshwar?",
    answer:
      "Narayan Nagbali is a sacred Vedic ritual performed exclusively at Trimbakeshwar Jyotirlinga to remove Pitru Dosha (ancestral curses and unresolved karmic debts of deceased family members). The pooja consists of two parts: (1) <strong>Narayan Bali</strong> — offerings to Lord Vishnu/Narayan for the peace of departed souls, and (2) <strong>Nag Bali</strong> — offerings to the Nagas (serpent deities) for removing the ill effects of unnatural or premature deaths. Together, these rituals liberate departed ancestors and remove their negative influence on living family members. Trimbakeshwar is the only temple in India where Narayan Nagbali is performed in its authentic Vedic form.",
  },
  {
    question: "Who should perform Narayan Nagbali pooja?",
    answer:
      "Narayan Nagbali is recommended for: (1) <strong>Families experiencing repeated misfortunes</strong> — unexplained financial losses, accidents, or illnesses. (2) <strong>Those who lost family members through unnatural death</strong> — accident, suicide, murder, drowning, fire, or death during pregnancy/childbirth. (3) <strong>Pitru Dosha detected in horoscope</strong> — identified by astrologers through the birth chart, especially Pitru Paksha dosha. (4) <strong>Unresolved family conflicts</strong> or lack of peace despite prosperity. (5) <strong>Couples facing infertility or repeated miscarriages</strong> attributed to ancestral curses. The pooja is performed by the eldest male member or family representative on behalf of the entire family.",
  },
  {
    question: "How much does Narayan Nagbali pooja cost at Trimbakeshwar?",
    answer:
      "The cost of Narayan Nagbali at Trimbakeshwar is approximately <strong>₹2,500–5,000</strong> per family. This includes priest dakshina (honorarium), all puja samagri (ritual materials: rice, flowers, fruits, ghee, incense), the sacred pit, ritual homa (fire ceremony), and prasad for the family. Additional dakshina is at the devotee's discretion. The pooja takes 2–3 hours. Contact the Shri Gajanan Maharaj Sansthan (+91 80531 90691 / +91 80531 90691) for booking and exact cost details.",
  },
  {
    question: "How do I book Narayan Nagbali pooja at Trimbakeshwar?",
    answer:
      "To book: (1) <strong>Call in advance</strong> — contact Shri Gajanan Maharaj Sansthan at <strong>+91 80531 90691</strong> or <strong>+91 80531 90691</strong>, at least 2–4 weeks before your visit. For Shravan and Maha Shivaratri, book 2–3 months ahead. (2) <strong>Provide details</strong> — family name, number of participants, date preference, specific rituals (Narayan Bali + Nag Bali), and gotra/clan information. (3) <strong>Confirm booking</strong> — pay a deposit (₹500–1,000) to secure the date. (4) <strong>On arrival</strong> — report to the temple priest's office at the designated time. Payment for the full pooja is made after completion based on satisfaction.",
  },
  {
    question: "What happens during the Narayan Nagbali pooja ritual?",
    answer:
      "The Narayan Nagbali is a multi-hour Vedic ceremony by trained Brahmin priests: (1) <strong>Ganesh Puja</strong> — invocation of Lord Ganesha to begin. (2) <strong>Pitra Tarpan</strong> — offerings of water, sesame seeds, and rice to ancestors while chanting their names and gotra. (3) <strong>Narayan Bali</strong> — offerings to Lord Vishnu/Narayan for liberating departed souls. (4) <strong>Nag Bali</strong> — offerings to Nagas to remove obstacles from unnatural deaths. (5) <strong>Homa (fire ritual)</strong> — the heart of the pooja with specific mantras. (6) <strong>Prasad distribution</strong> — sacred prasad for the family. The ritual is in Sanskrit and Marathi, with the priest explaining key moments.",
  },
  {
    question: "Can Narayan Nagbali be performed at home or any other temple?",
    answer:
      "According to Vedic tradition, Narayan Nagbali must be performed at Trimbakeshwar Jyotirlinga — the only temple in India authorised to conduct this ritual in its authentic form. The ritual's effectiveness depends on the sacred geography: the temple at the foot of Brahmagiri, the Trimbakeshwar Jyotirlinga, and the Godavari's origin at Kushavarta Kund. This combination amplifies the ritual's power and ensures liberation of departed souls. Attempting it at home or another temple is not considered effective. Devotees travel from Mumbai, Pune, Delhi, and internationally to perform this pooja at Trimbakeshwar.",
  },
  {
    question: "What is the difference between Narayan Nagbali, Nagbali, and Nag Panchami?",
    answer:
      "They are completely different: <strong>Narayan Nagbali</strong> (at Trimbakeshwar) — a 2–3 hour Vedic ritual combining Narayan Bali + Nag Bali for Pitru Dosha removal. Performed by Brahmin priests with fire ceremony. <strong>Nagbali alone</strong> — a shorter version focusing only on the Nag Bali component. <strong>Nag Panchami</strong> — a simple annual festival (5th day of Shravan) when devotees offer milk and flowers to snake idols at home or local temples. The only similarity is the word 'Nag'. <strong>Narayan Bali at Gaya</strong> — a different ritual at Gaya Vishnupad Temple in Bihar for Pitru Shraddha. Trimbakeshwar's Narayan Nagbali is unique and cannot be substituted.",
  },
];

const faqSchema = getFAQSchema(faqs);
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Trimbakeshwar Jyotirlinga", url: "/trimbakeshwar-jyotirlinga" },
  { name: "Narayan Nagbali Pooja", url: "/narayan-nagbali-trimbakeshwar" },
]);

const structuredPayload = [templeSchema, lodgingSchema, faqSchema, breadcrumbSchema];
---

<Layout meta={meta}>
  {
    structuredPayload.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }

  <!-- Hero -->
  <section class="bg-gradient-to-br from-rose-50 via-pink-50 to-red-100 border-b border-rose-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <nav class="text-sm text-rose-800/70 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:underline">Home</a>
        <span class="mx-2">/</span>
        <a href="/trimbakeshwar-jyotirlinga" class="hover:underline">Trimbakeshwar Jyotirlinga</a>
        <span class="mx-2">/</span>
        <span class="text-rose-900 font-medium">Narayan Nagbali Pooja</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-bold text-rose-900 leading-tight">
        Narayan Nagbali Pooja at Trimbakeshwar — Ritual &amp; Booking Guide 2026
      </h1>
      <p class="mt-6 text-lg md:text-xl text-rose-900/80 max-w-3xl">
        Complete guide to Narayan Nagbali pooja at Trimbakeshwar: the only Vedic ritual in India for Pitru Dosha removal. Learn about the pooja procedure, cost from ₹2,500, booking process, who should perform it, and why Trimbakeshwar is the only authentic location.
      </p>
    </div>
  </section>

  <!-- Key Facts -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-rose-900">At a Glance</h2>
      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-xl border border-rose-200 bg-rose-50/60 p-5 text-center">
          <p class="text-xs text-rose-700 uppercase tracking-wide">Pooja Cost</p>
          <p class="text-xl font-bold text-rose-900 mt-1">₹2,500–5,000</p>
          <p class="text-sm text-rose-900/70">per family</p>
        </div>
        <div class="rounded-xl border border-rose-200 bg-rose-50/60 p-5 text-center">
          <p class="text-xs text-rose-700 uppercase tracking-wide">Duration</p>
          <p class="text-xl font-bold text-rose-900 mt-1">2–3 hrs</p>
          <p class="text-sm text-rose-900/70">full ritual</p>
        </div>
        <div class="rounded-xl border border-rose-200 bg-rose-50/60 p-5 text-center">
          <p class="text-xs text-rose-700 uppercase tracking-wide">Only at</p>
          <p class="text-xl font-bold text-rose-900 mt-1">Trimbakeshwar</p>
          <p class="text-sm text-rose-900/70">authentic Vedic form</p>
        </div>
        <div class="rounded-xl border border-rose-200 bg-rose-50/60 p-5 text-center">
          <p class="text-xs text-rose-700 uppercase tracking-wide">Booking Lead</p>
          <p class="text-xl font-bold text-rose-900 mt-1">2–4 weeks</p>
          <p class="text-sm text-rose-900/70">festivals: 2–3 months</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What is Narayan Nagbali -->
  <section class="py-16 bg-rose-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-rose-900">What is Narayan Nagbali?</h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="rounded-xl border border-rose-200 bg-white p-6">
          <h3 class="text-lg font-semibold text-rose-900 mb-3">Narayan Bali</h3>
          <p class="text-rose-900/80 text-sm leading-relaxed">
            The Narayan Bali component involves offerings to Lord Vishnu/Narayan for the liberation and peace of departed ancestors. Family members participate by chanting the names and gotra of their ancestors while offering water, sesame seeds, and rice. This ritual is believed to free the souls of departed family members from unresolved attachments and grant them moksha (liberation).
          </p>
        </div>
        <div class="rounded-xl border border-rose-200 bg-white p-6">
          <h3 class="text-lg font-semibold text-rose-900 mb-3">Nag Bali</h3>
          <p class="text-rose-900/80 text-sm leading-relaxed">
            The Nag Bali component involves offerings to the Nagas (serpent deities) to remove the negative effects of unnatural or premature deaths in the family — including deaths by accident, drowning, snakebite, fire, fall from height, or during pregnancy/childbirth. This addresses Pitru Dosha that specifically arises from violent or premature death.
          </p>
        </div>
      </div>
      <div class="mt-8 rounded-xl border border-rose-200 bg-rose-50/60 p-6 md:p-8">
        <p class="text-rose-900/80 leading-relaxed">
          Together, <strong>Narayan Nagbali</strong> is one of the most powerful Vedic rituals in Hinduism. It is believed to: remove Pitru Dosha from the family's astrological chart, bring peace and prosperity to the living family members, remove obstacles in health, finances, marriage, and children, and ensure liberation of the departed souls from the cycle of rebirth. Trimbakeshwar is the only temple in India where this specific combination can be performed in its authentic Vedic form, amplified by the sacred energy of the Jyotirlinga and the Godavari's origin at Kushavarta Kund.
        </p>
      </div>
    </div>
  </section>

  <!-- Who should do it -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-rose-900">Who Should Perform Narayan Nagbali?</h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-rose-200 bg-rose-50/40 p-6">
          <h3 class="text-lg font-semibold text-rose-900 mb-3">Recommended For</h3>
          <ul class="space-y-2 text-rose-900/80 text-sm">
            <li>• Repeated misfortunes across multiple family members</li>
            <li>• Family members who died unnatural deaths (accident, suicide, fire)</li>
            <li>• Pitru Dosha confirmed by astrologer in the birth chart</li>
            <li>• Unresolved family conflicts despite material prosperity</li>
            <li>• Unexplained infertility or repeated miscarriages</li>
            <li>• Chronic health issues with no medical explanation</li>
            <li>• Dreams of ancestors asking for help or water</li>
          </ul>
        </div>
        <div class="rounded-xl border border-rose-200 bg-rose-50/40 p-6">
          <h3 class="text-lg font-semibold text-rose-900 mb-3">Ritual Details</h3>
          <ul class="space-y-2 text-rose-900/80 text-sm">
            <li>• Performed by the eldest male or family representative</li>
            <li>• Entire family should be present for the 2–3 hour ritual</li>
            <li>• Requires sattvic diet (no non-veg, no alcohol) for 3 days</li>
            <li>• Wear traditional white or light-colored clothing</li>
            <li>• Men: dhoti; Women: saree or salwar kameez</li>
            <li>• Can be combined with Kushavarta Kund holy dip</li>
            <li>• Accommodation at Bhakta Niwas recommended</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-rose-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-rose-900">Frequently Asked Questions</h2>
      <div class="mt-8 space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-xl border border-rose-200 bg-white p-5 open:shadow-sm">
              <summary class="cursor-pointer list-none flex justify-between items-center font-semibold text-rose-900">
                <span>{faq.question}</span>
                <span class="text-rose-700 text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-3 text-rose-900/80 leading-relaxed">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gradient-to-r from-rose-700 to-pink-700 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold">Book Narayan Nagbali Pooja at Trimbakeshwar</h2>
      <p class="mt-4 text-rose-100/90 max-w-2xl mx-auto">
        Call +91 80531 90691 or +91 80531 90691 to book. Book 2–4 weeks in advance for the best dates.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/booking" class="inline-flex items-center px-7 py-3 rounded-lg bg-white text-rose-800 font-semibold shadow hover:bg-rose-50 transition">Book Pooja & Stay</a>
        <a href="/trimbakeshwar-jyotirlinga" class="inline-flex items-center px-7 py-3 rounded-lg border border-white/60 text-white font-semibold hover:bg-white/10 transition">Trimbakeshwar Guide</a>
        <a href="/contact" class="inline-flex items-center px-7 py-3 rounded-lg border border-white/60 text-white font-semibold hover:bg-white/10 transition">Contact Sansthan</a>
      </div>
    </div>
  </section>
</Layout>
